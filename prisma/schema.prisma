// Esquema de datos de Preciara (Fase 2A).
//
// Motor: MySQL (Hostinger). El cliente de Prisma se genera en
// `src/generated/prisma` (ver `generator client` más abajo) y se consume
// siempre a través del singleton `src/lib/prisma.ts`, nunca directamente
// desde componentes visuales.

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

/// Categoría del catálogo (p. ej. "Tecnología", "Hogar").
model Category {
  id          Int      @id @default(autoincrement())
  slug        String   @unique @db.VarChar(120)
  name        String   @db.VarChar(120)
  description String?  @db.Text
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  products Product[]

  @@index([isActive])
  @@map("categories")
}

/// Producto del catálogo. Un mismo producto puede tener varias ofertas: de
/// comercios distintos, y también varias del mismo origen/comercio cuando
/// son anuncios/listados distintos (p. ej. dos listados de eBay del mismo
/// producto con `externalId` distinto) — ver `Offer`.
model Product {
  id          Int      @id @default(autoincrement())
  slug        String   @unique @db.VarChar(160)
  name        String   @db.VarChar(200)
  description String?  @db.Text
  brand       String?  @db.VarChar(100)
  model       String?  @db.VarChar(100)
  /// GTIN mostrado/heredado del importador CSV histórico: texto libre, sin
  /// validar ni normalizar (comportamiento previo, sin cambios) — nunca se
  /// usa para relacionar ofertas entre fuentes. Ver `canonicalGtin`.
  ean         String?  @db.VarChar(32)
  /// GTIN normalizado a 14 dígitos (dígito de control ya validado; ver
  /// src/server/catalogSync/gtin.ts), escrito SOLO por el núcleo de
  /// sincronización de catálogos. Es la clave real de coincidencia entre
  /// ofertas de distintas fuentes para el mismo producto físico (ver
  /// applyOffer.ts) — columna nueva y propia, `@unique` desde el principio,
  /// para no arriesgar la migración a datos históricos de `ean` que nunca
  /// se validaron ni normalizaron y podrían tener duplicados o formatos
  /// distintos para el mismo código. La unicidad es lo que impide que dos
  /// sincronizaciones concurrentes (p. ej. Awin y eBay a la vez) creen dos
  /// productos para el mismo GTIN — ver "resolución atómica" en
  /// applyOffer.ts.
  canonicalGtin String? @unique @db.VarChar(14)
  imageUrl    String?  @db.VarChar(500)
  categoryId  Int
  isActive    Boolean  @default(true)
  /// true = fila de datos de demostración (seed), nunca un producto real. Ver README.
  isDemo      Boolean  @default(false)
  /// Fuente cuyos datos "poseen" actualmente name/brand/model/imageUrl (ver
  /// src/server/catalogSync/metadataPolicy.ts): evita que sincronizaciones
  /// de fuentes de menor prioridad hagan oscilar estos campos en cada
  /// ejecución. `null` = todavía sin sincronizar por el núcleo nuevo (p. ej.
  /// productos creados solo por el importador CSV histórico o el seed).
  metadataSource OfferSource?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  category Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  offers   Offer[]

  @@index([categoryId])
  @@index([isActive])
  @@index([categoryId, isActive])
  @@index([ean])
  @@map("products")
}

/// Comercio/tienda que publica ofertas.
model Merchant {
  id         Int      @id @default(autoincrement())
  slug       String   @unique @db.VarChar(120)
  name       String   @db.VarChar(120)
  websiteUrl String   @db.VarChar(500)
  logoUrl    String?  @db.VarChar(500)
  isActive   Boolean  @default(true)
  /// true = comercio ficticio de demostración (seed), nunca un comercio real. Ver README.
  isDemo     Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  offers Offer[]

  @@index([isActive])
  @@map("merchants")
}

/// Estado de disponibilidad de una oferta (y de cada instantánea de su historial).
enum Availability {
  IN_STOCK
  OUT_OF_STOCK
  PREORDER
  DISCONTINUED
  UNKNOWN
}

/// Origen de una oferta: qué sistema la trajo. `CSV` es el importador manual
/// ya existente (valor por defecto, incluido para todas las filas creadas
/// antes de que este campo existiera). `AWIN`/`EBAY` son las fuentes
/// previstas para el núcleo de sincronización — todavía sin conectar, ver
/// src/server/catalogSync/*. Lista pensada para crecer (nuevo valor =
/// migración aditiva, nunca rompe las filas existentes).
enum OfferSource {
  CSV
  AWIN
  EBAY
}

/// Oferta de un producto en un comercio concreto, proveniente de una fuente.
/// La identidad estable de una oferta es (source, merchant, externalId) —
/// ver `@@unique` más abajo y src/server/catalogSync/applyOffer.ts — no
/// (producto, comercio): un mismo producto puede tener varias ofertas del
/// mismo comercio/fuente cuando son anuncios distintos (p. ej. dos listados
/// de eBay del mismo producto con `externalId` distinto).
model Offer {
  id            Int      @id @default(autoincrement())
  productId     Int
  merchantId    Int
  /// Fuente de esta oferta. Ver `OfferSource`.
  source        OfferSource @default(CSV)
  /// Identificador propio de la fuente para esta oferta concreta (SKU, id
  /// de listado de Awin/eBay...). Opcional solo por compatibilidad con el
  /// importador CSV histórico, donde nunca formó parte de la identidad de
  /// la oferta; las fuentes nuevas (Awin/eBay) deben aportarlo siempre —
  /// ver NormalizedOfferRow en src/server/catalogSync/types.ts.
  externalId    String?  @db.VarChar(120)
  currentPrice  Decimal  @db.Decimal(10, 2)
  previousPrice Decimal? @db.Decimal(10, 2)
  currency      String   @default("EUR") @db.VarChar(3)
  productUrl    String   @db.VarChar(700)
  affiliateUrl  String?  @db.VarChar(700)
  availability  Availability @default(UNKNOWN)
  shippingCost  Decimal? @db.Decimal(10, 2)
  isActive      Boolean  @default(true)
  /// true = oferta de demostración (seed), nunca un precio real. Ver README.
  isDemo        Boolean  @default(false)
  lastCheckedAt DateTime
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  product        Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  merchant       Merchant        @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  priceSnapshots PriceSnapshot[]

  // Identidad estable de la oferta: fuente + comercio + id externo. NO
  // incluye productId a propósito (una oferta conserva su identidad aunque
  // se corrija a qué producto está enlazada). Para el importador CSV
  // histórico (externalId casi siempre ausente), la resolución sigue
  // acotándose también por producto a nivel de aplicación — ver applyRow en
  // src/server/importer/run.ts — porque MySQL trata cada NULL de
  // `externalId` como distinto y esta restricción por sí sola no lo
  // deduplicaría.
  @@unique([source, merchantId, externalId])
  @@index([productId])
  @@index([merchantId])
  @@index([source, merchantId])
  @@index([isActive])
  @@index([lastCheckedAt])
  @@index([availability])
  @@map("offers")
}

/// Punto histórico de precio/disponibilidad de una oferta. Solo se crea uno
/// nuevo cuando algo relevante cambia respecto al último registro (ver
/// capa de importación); no es una foto diaria automática.
model PriceSnapshot {
  id           Int          @id @default(autoincrement())
  offerId      Int
  price        Decimal      @db.Decimal(10, 2)
  shippingCost Decimal?     @db.Decimal(10, 2)
  availability Availability @default(UNKNOWN)
  recordedAt   DateTime     @default(now())

  offer Offer @relation(fields: [offerId], references: [id], onDelete: Cascade)

  @@index([offerId, recordedAt])
  @@map("price_snapshots")
}

/// Estado de una ejecución del importador (CSV hoy; otras fuentes en el futuro).
enum ImportStatus {
  RUNNING
  SUCCESS
  PARTIAL
  FAILED
}

/// Registro de una ejecución del importador, con sus contadores y resumen.
model ImportRun {
  id               Int          @id @default(autoincrement())
  /// Origen de los datos, p. ej. "csv:manual", "csv:cron/ofertas.csv".
  source           String       @db.VarChar(160)
  status           ImportStatus @default(RUNNING)
  startedAt        DateTime     @default(now())
  finishedAt       DateTime?
  rowsRead         Int          @default(0)
  productsCreated  Int          @default(0)
  productsUpdated  Int          @default(0)
  offersCreated    Int          @default(0)
  offersUpdated    Int          @default(0)
  rowsRejected     Int          @default(0)
  /// Resumen corto del error si `status` es FAILED. Nunca contiene secretos.
  errorSummary     String?      @db.VarChar(500)
  /// Metadatos adicionales (nombre de fichero, modo dry-run, duración...). Nunca secretos.
  metadata         Json?

  errors ImportError[]

  @@index([status])
  @@index([startedAt])
  @@map("import_runs")
}

/// Error de una fila concreta dentro de una ejecución del importador.
model ImportError {
  id          Int      @id @default(autoincrement())
  importRunId Int
  /// Número de fila del CSV (1 = primera fila de datos), si aplica.
  rowNumber   Int?
  /// Código corto y estable, p. ej. "INVALID_PRICE", "MISSING_MERCHANT_SLUG".
  errorCode   String   @db.VarChar(60)
  message     String   @db.VarChar(500)
  /// Copia saneada de los campos de la fila (nunca cabeceras/credenciales), para depurar sin re-subir el CSV.
  rowData     Json?
  createdAt   DateTime @default(now())

  importRun ImportRun @relation(fields: [importRunId], references: [id], onDelete: Cascade)

  @@index([importRunId])
  @@map("import_errors")
}

/// Configuración de cadencia por fuente de sincronización (Awin, eBay...).
/// Deliberadamente sin valores de cadencia reales todavía: `enabled` empieza
/// en `false` y `intervalMinutes` en un valor genérico, hasta que se conecte
/// cada fuente y se decida su frecuencia real según sus condiciones de uso.
/// Editable sin desplegar código (panel técnico, fase posterior) en cuanto
/// exista una pantalla para ello; hoy solo se lee/escribe desde
/// src/server/catalogSync/*.
model SyncSourceConfig {
  id              Int         @id @default(autoincrement())
  source          OfferSource @unique
  /// Minutos entre ejecuciones. Valor por defecto genérico (24h): no es una
  /// recomendación para Awin ni para eBay, solo un valor de arranque seguro.
  intervalMinutes Int         @default(1440)
  /// false por defecto: nada se ejecuta automáticamente hasta activarlo a
  /// propósito, una vez la fuente esté realmente conectada.
  enabled         Boolean     @default(false)
  lastRunAt       DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@map("sync_source_configs")
}

/// Bloqueo distribuido por "lease" (concesión con caducidad), en sustitución
/// de GET_LOCK/RELEASE_LOCK de MySQL para el núcleo de sincronización de
/// catálogos: GET_LOCK/RELEASE_LOCK exigen ejecutarse sobre la MISMA
/// conexión física, algo que el pool de conexiones de Prisma no garantiza
/// entre dos llamadas `$queryRawUnsafe` seguidas (comprobado de forma
/// empírica: un test quedó con el bloqueo retenido de forma intermitente).
/// Un lease no depende de qué conexión lo pidió: es una fila con una
/// caducidad (`expiresAt`) que cualquier conexión puede leer/actualizar de
/// forma atómica (`UPDATE ... WHERE expiresAt < NOW()`), así que nunca
/// puede quedar retenido para siempre — como mucho, hasta que expire.
/// Ver src/server/importer/distributedLock.ts.
model SyncLock {
  /// Nombre del bloqueo (p. ej. "preciara_catalog_sync:AWIN").
  name       String   @id @db.VarChar(190)
  /// Identificador aleatorio de quien sostiene el lease ahora mismo: solo
  /// su propio titular puede liberarlo o renovarlo, para no interferir con
  /// quien lo haya tomado después de que el titular anterior caducara.
  holderId   String   @db.VarChar(64)
  /// A partir de este instante, cualquiera puede tomar el bloqueo aunque la
  /// fila siga existiendo (el titular anterior no lo liberó — proceso
  /// caído, excepción no controlada, etc.).
  expiresAt  DateTime
  acquiredAt DateTime @default(now())

  @@index([expiresAt])
  @@map("sync_locks")
}
