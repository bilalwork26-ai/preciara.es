# Copia este archivo como .env.local (para Next.js) y también como .env
# (para que la CLI de Prisma la lea automáticamente) y rellena los valores
# reales. Nunca subas .env ni .env.local al repositorio: ya están
# ignorados en .gitignore. Nunca escribas aquí contraseñas reales.

# URL pública del sitio (usada en metadatos SEO/Open Graph).
NEXT_PUBLIC_SITE_URL=https://preciara.es

# --- Fase 2A: base de datos MySQL ---
# Sin esta variable, la web sigue funcionando con los datos de demostración
# de src/data/demo/*: nunca falla ni muestra una página en blanco.
# Formato: mysql://usuario:contraseña@host:puerto/nombre_base_de_datos
# El valor de abajo es un EJEMPLO FALSO, no una credencial real.
# DATABASE_URL="mysql://usuario:contrasena-falsa-de-ejemplo@localhost:3306/preciara"

# --- Fase 2A: panel técnico (/admin) ---
# Sin AMBAS variables, /admin y /api/admin quedan cerrados (404) siempre.
# Genera valores propios, largos y aleatorios (p. ej. `openssl rand -hex 32`).
# No reutilices los ejemplos de abajo ni ningún valor de este fichero.
# ADMIN_PASSWORD=cambia-este-valor-por-una-contrasena-larga-y-aleatoria
# ADMIN_SESSION_SECRET=cambia-este-valor-por-otro-secreto-largo-y-distinto

# --- Fase 2A: caducidad de ofertas ---
# Horas sin revisar una oferta antes de considerarla "vieja" en el panel
# técnico y candidata a desactivar con `npm run db:import -- --deactivate-stale`.
# Opcional: por defecto 72 horas si no se define.
# OFFER_STALE_AFTER_HOURS=72

# --- Fase 3: endpoint de sincronización de precios (aún no implementado) ---
# Secreto compartido con GitHub Actions para autorizar POST /api/jobs/sync-prices
# vía cabecera Authorization: Bearer <SYNC_JOB_SECRET>. Genera un valor propio
# largo y aleatorio; no reutilices este ejemplo.
# SYNC_JOB_SECRET=cambia-este-valor-por-un-secreto-largo-y-aleatorio

# --- eBay: endpoint de Marketplace Account Deletion (GET/POST /api/ebay/marketplace-account-deletion) ---
# Requisito obligatorio de cumplimiento de eBay. NUNCA generes, imprimas,
# registres ni commitees el valor real de ninguna de estas variables.
#
# EBAY_MARKETPLACE_DELETION_ENDPOINT: la URL pública EXACTA (protocolo +
# host + ruta) que configures en el panel de desarrollador de eBay para
# este endpoint — debe coincidir carácter por carácter, se usa en el
# cálculo del hash de validación.
#
# EBAY_MARKETPLACE_DELETION_VERIFICATION_TOKEN: el token de verificación
# que generes y pegues también en el panel de eBay. El valor real tendrá
# entre 32 y 80 caracteres: solo letras, números, guion (-) y guion bajo (_).
EBAY_MARKETPLACE_DELETION_ENDPOINT=
EBAY_MARKETPLACE_DELETION_VERIFICATION_TOKEN=

# EBAY_CLIENT_ID / EBAY_CLIENT_SECRET (App ID / Cert ID de tu app de eBay):
# necesarios para obtener el token OAuth de aplicación con el que eBay
# exige autenticar la descarga de su clave pública de notificaciones —
# sin esto, el POST del endpoint nunca puede verificar una firma de
# verdad y responde 412 siempre (nunca finge un 204). No son específicos
# de Marketplace Account Deletion: son las credenciales generales de tu
# app en el panel de desarrollador de eBay.
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=

# --- Awin: ejecutor de sincronización de catálogo (npm run catalog:sync:awin) ---
# Pensado para un cron job personalizado de Hostinger (todavía sin configurar
# aquí) — ver scripts/sync-awin.ts. NUNCA generes, imprimas, registres ni
# commitees el valor real de ninguna de estas variables.
#
# AWIN_DATAFEED_API_KEY: API key de "Product Feed List Download"/descarga de
# feeds de tu cuenta de Awin. OBLIGATORIA para una ejecución real: ausente,
# vacía o solo espacios detiene el script antes de tocar Awin o la base de
# datos.
# AWIN_DATAFEED_API_KEY=
#
# AWIN_DATAFEED_LIST_URL: enlace COMPLETO de "Descargar lista" mostrado por
# la interfaz nueva de Awin. Es secreto y debe guardarse sin recortar, desde
# https://ui.awin.com/ hasta /feedlist. Opcional para instalaciones Legacy.
# AWIN_DATAFEED_LIST_URL=
#
# AWIN_DEACTIVATE_STALE_AFTER_HOURS: horas sin refrescar una oferta de Awin
# antes de poder desactivarla (ver la regla conservadora de
# awinOrchestrator.ts: solo si TODOS los feeds de ese anunciante terminaron
# bien, ninguno vacío y ninguna fila inválida). Opcional — si se omite,
# ningún ciclo desactiva ofertas viejas de Awin (opción más segura por
# defecto). Si se indica, debe ser un número finito, positivo y como mucho
# 8760 (un año); cualquier otro valor detiene el script antes de iniciar el
# ciclo.
# AWIN_DEACTIVATE_STALE_AFTER_HOURS=72
